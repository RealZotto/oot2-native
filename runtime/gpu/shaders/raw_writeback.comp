// Raw write-back (oot2/vk_raw.h): at the end of a raw-access submission, after its own work, copy the page table's
// header and miss log out and zero its miss count, and for every mirrored page whose store bit is set clear the bit, note
// the page in a bitmap, and copy the page into the guest's own page through the page's sink (a host import over the
// guest's pages), so the CPU writes none of it: the completion thread then logs the misses and stamps the pages, before
// the value is done. A page with no sink (the guest has no committed page there) is noted and not copied.
//
// Every address comes in the push constants, and so do the table's word offsets (oot2/raw_table.h), so this file holds
// no copy of the ABI. The out buffer, in words: [0] the pages taken, [head, head + head_words) the table's first
// head_words words, then from `list` one bit for each page of the page list, set when the page was written.
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words {
    uint w[];
};

// A page's bytes copied four words at a time: both ends are 4 KiB aligned.
layout(buffer_reference, std430, buffer_reference_align = 16) buffer Quads {
    uvec4 q[];
};

// A mirrored page (oot2/vk_raw.h, RawMirrorPage, 32 bytes, two entries of the array): the first, x its leaf slot and zw the
// device address of its bytes in the mirror; the second, xy the device address of the guest's page through its sink
// (0 for none).
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Pages {
    uvec4 p[];
};

layout(push_constant) uniform Raw {
    uvec2 table;
    uvec2 pages;
    uvec2 dst;
    uint count;        // mirrored pages in the list
    uint bits_word;    // RAW_STORE_BITS_WORD
    uint miss_word;    // RAW_HEADER_MISS_COUNT
    uint head_words;   // RAW_MISS_LOG_WORD + RAW_MISS_ENTRIES * RAW_MISS_ENTRY_WORDS
} raw;

const uint HEAD = 16u;
const uint PAGE_QUADS = 256u;

shared uint s_hit;

void main() {
    Words t = Words(raw.table);
    Words o = Words(raw.dst);
    uint lane = gl_LocalInvocationIndex;
    uint list = HEAD + raw.head_words;
    if (gl_WorkGroupID.x == 0u) {
        for (uint i = lane; i < raw.head_words; i += gl_WorkGroupSize.x) o.w[HEAD + i] = t.w[i];
        barrier();
        if (lane == 0u) t.w[raw.miss_word] = 0u;
    }
    for (uint i = gl_WorkGroupID.x; i < raw.count; i += gl_NumWorkGroups.x) {
        uvec4 e = Pages(raw.pages).p[2u * i];
        uvec4 f = Pages(raw.pages).p[2u * i + 1u];
        if (lane == 0u) {
            uint word = raw.bits_word + (e.x >> 5u), bit = 1u << (e.x & 31u);
            uint hit = 0u;
            if ((t.w[word] & bit) != 0u) {
                atomicAnd(t.w[word], ~bit);
                atomicAdd(o.w[0], 1u);
                atomicOr(o.w[list + (i >> 5u)], 1u << (i & 31u));
                hit = 1u;
            }
            s_hit = hit;
        }
        barrier();
        if (s_hit != 0u && (f.x | f.y) != 0u) {
            Quads src = Quads(e.zw);
            Quads dst = Quads(f.xy);
            for (uint k = lane; k < PAGE_QUADS; k += gl_WorkGroupSize.x) dst.q[k] = src.q[k];
        }
        barrier();
    }
}
